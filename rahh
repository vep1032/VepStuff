function BaseGroupbox:AddToggle(idx, info)
	info = info or {}
	if Library.ForceCheckbox then return self:AddCheckbox(idx, info) end

	local Holder, Line, Addons = Row(self.Container, 26)
	local Toggle = WithAddons(Element({
		Type = "Toggle", Value = info.Default == true, Text = info.Text or idx,
		Risky = info.Risky, Callback = info.Callback,
	}), Holder, Addons)

	local function LabelColor()
		if Toggle.Risky then return Scheme.Red end
		return Toggle.Value and Scheme.FontColor or Scheme.SubFontColor
	end

	local Lbl = Text({ Size = UDim2.new(1, -50, 1, 0), Text = Toggle.Text, TextColor3 = LabelColor, TextTruncate = Enum.TextTruncate.AtEnd, RichText = true, Parent = Line })
	local Switch = New("Frame", {
		Size = UDim2.fromOffset(32, 16), LayoutOrder = 1e9, Parent = Addons,
		BackgroundColor3 = function() return Toggle.Value and Scheme.AccentColor or Scheme.ComponentColor end,
	})
	Round(Switch)
	New("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Switch,
		Color = function() return Toggle.Value and Scheme.AccentColor or Scheme.OutlineColor end,
	})
	-- glow stays inside 2px of the switch (old one went way out of bounds)
	local Glow = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 4, 1, 4),
		BackgroundTransparency = 1, Parent = Switch,
	})
	Round(Glow)
	local GlowStroke = Stroke(Glow, "AccentColor", 2, 1)
	local Knob = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = function() return Toggle.Value and WHITE or Scheme.SubFontColor end, Parent = Switch,
	})
	Round(Knob)
	local Hit = Btn({ Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = Line })

	local function Render(instant)
		local on = Toggle.Value
		local t = instant and 0 or 0.22
		Tween(Knob, { Position = on and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = on and WHITE or Scheme.SubFontColor }, t)
		Tween(Switch, { BackgroundColor3 = on and Scheme.AccentColor or Scheme.ComponentColor }, t)
		Tween(GlowStroke, { Transparency = on and 0.7 or 1 }, t)
		Tween(Lbl, { TextColor3 = LabelColor() }, t)
		Switch.UIStroke.Color = on and Scheme.AccentColor or Scheme.OutlineColor
	end

	function Toggle:SetValue(v)
		v = v == true
		if v == self.Value then return end
		self.Value = v
		Render()
		self:_fire()
	end

	Hit.MouseButton1Click:Connect(function()
		if not Toggle.Disabled then Toggle:SetValue(not Toggle.Value) end
	end)

	Common(Toggle, Holder, Lbl, Hit, info)
	Render(true)
	Toggles[idx] = Toggle
	return Toggle
end

