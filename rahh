local function IsAsset(icon)
	return type(icon) == "number" or (type(icon) == "string" and (icon:find("rbxassetid") or icon:find("rbxasset://") or icon:match("^%d+$")))
end

local function AssetId(icon)
	if type(icon) == "number" or (type(icon) == "string" and icon:match("^%d+$")) then
		return "rbxassetid://" .. icon
	end
	return icon
end

local function Card(column)
	local Box = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundColor3 = "MainColor",
		BackgroundTransparency = 0.3, LayoutOrder = NextOrder(), Parent = column,
	})
	Corner(Box, 8)
	Stroke(Box, "OutlineColor", 1, 0.2)
	List(Box, 0)
	return Box
end

local function Container(parent, order)
	local C = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, BackgroundTransparency = 1,
		LayoutOrder = order, Parent = parent,
	})
	List(C, 6)
	Pad(C, 10, 10, 8, 10)
	return C
end

local function CreateGroupbox(column, opts)
	local Box = Card(column)
	local Header = New("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = 0, Parent = Box })
	local Bar = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(3, 13),
		BackgroundColor3 = "AccentColor", BorderSizePixel = 0, Parent = Header,
	})
	Round(Bar)
	local x = 20
	local icon = opts.IconName or opts.Icon
	if IsAsset(icon) then
		New("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 20, 0.5, 0), Size = UDim2.fromOffset(14, 14),
			BackgroundTransparency = 1, Image = AssetId(icon), ImageColor3 = "AccentColor", Parent = Header,
		})
		x = 40
	end
	Text({ Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x - 30, 1, 0), Text = opts.Name or "Groupbox", FontFace = FONT_BOLD, TextSize = 13, Parent = Header })

	local Sep = New("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = "OutlineColor", BackgroundTransparency = 0.2, BorderSizePixel = 0, LayoutOrder = 1, Parent = Box })
	local C = Container(Box, 2)

	if opts.Description then
		local d = Text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, Text = opts.Description, TextSize = 12, TextColor3 = "SubFontColor", LayoutOrder = 0, Parent = C })
		d.LayoutOrder = -1
	end

	local Groupbox = setmetatable({ Container = C, Box = Box, Name = opts.Name }, BaseGroupbox)

	if not opts.DisableCollapsing then
		local Col = Btn({
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(18, 18),
			Text = "▾", TextSize = 13, TextColor3 = "SubFontColor", Parent = Header,
		})
		function Groupbox:SetCollapsed(c)
			C.Visible = not c
			Sep.Visible = not c
			Tween(Col, { Rotation = c and -90 or 0 }, 0.2)
		end
		Col.MouseButton1Click:Connect(function() Groupbox:SetCollapsed(C.Visible) end)
		if opts.Collapsed then Groupbox:SetCollapsed(true) end
	end

	return Groupbox
end

local function CreateTabbox(column)
	local Box = Card(column)
	local Header = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 0, Parent = Box })
	List(Header, 0, Enum.FillDirection.Horizontal)
	New("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = "OutlineColor", BackgroundTransparency = 0.2, BorderSizePixel = 0, LayoutOrder = 1, Parent = Box })

	local Tabbox = { Tabs = {}, _list = {} }

	function Tabbox:AddTab(name)
		local B = Btn({ Text = name, FontFace = FONT_BOLD, TextColor3 = "SubFontColor", LayoutOrder = #Tabbox._list + 1, Parent = Header })
		local Under = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0, 0, 0, 2),
			BackgroundColor3 = "AccentColor", BorderSizePixel = 0, Parent = B,
		})
		local C = Container(Box, 2)
		C.Visible = false
		local Sub = setmetatable({ Container = C, Name = name }, BaseGroupbox)
		local entry = { B = B, Under = Under, C = C }

		function Sub:Show()
			for _, e in ipairs(Tabbox._list) do
				e.C.Visible = false
				Tween(e.B, { TextColor3 = Scheme.SubFontColor })
				Tween(e.Under, { Size = UDim2.new(0, 0, 0, 2) })
			end
			C.Visible = true
			Tween(B, { TextColor3 = Scheme.FontColor })
			Tween(Under, { Size = UDim2.new(0.6, 0, 0, 2) })
		end
		B.MouseButton1Click:Connect(function() Sub:Show() end)

		table.insert(Tabbox._list, entry)
		Tabbox.Tabs[name] = Sub
		local n = #Tabbox._list
		for _, e in ipairs(Tabbox._list) do e.B.Size = UDim2.new(1 / n, 0, 1, 0) end
		if n == 1 then Sub:Show() end
		return Sub
	end

	return Tabbox
end

