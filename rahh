local function Row(container, height, noAddons)
	local Holder = New("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y,
		LayoutOrder = NextOrder(), Parent = container,
	})
	List(Holder, 6)
	local Line = New("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 0),
		AutomaticSize = height and AUTO_NONE or AUTO_Y, LayoutOrder = 0, Parent = Holder,
	})
	local Addons
	if not noAddons then
		Addons = New("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 0, 1, 0), AutomaticSize = AUTO_X, ZIndex = 3, Parent = Line,
		})
		List(Addons, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	end
	return Holder, Line, Addons
end

local function Common(obj, Holder, Lbl, hover, info)
	function obj:SetVisible(v)
		self.Visible = v
		Holder.Visible = v
	end
	function obj:SetText(t)
		self.Text = t
		if Lbl then Lbl.Text = t end
	end
	function obj:SetDisabled(d)
		self.Disabled = d
		if Lbl then Lbl.TextTransparency = d and 0.55 or 0 end
	end
	function obj:SetTooltip(t) info.Tooltip = t end
	obj.Holder = Holder
	obj:SetVisible(info.Visible ~= false)
	if info.Disabled then obj:SetDisabled(true) end
	if hover then
		AddTooltip(hover, function()
			if obj.Disabled then return info.DisabledTooltip end
			return info.Tooltip
		end)
	end
end

local CreateColorPicker, CreateKeyPicker

local function WithAddons(obj, Holder, Addons)
	function obj:AddColorPicker(idx, info)
		CreateColorPicker(self, Holder, Addons, idx, info or {})
		return self
	end
	function obj:AddKeyPicker(idx, info)
		CreateKeyPicker(self, Holder, Addons, idx, info or {})
		return self
	end
	return obj
end

-- colorpicker ---------------------------------------------------------------

CreateColorPicker = function(_, Holder, Addons, idx, info)
	local CP = Element({
		Type = "ColorPicker", Value = info.Default or WHITE, Transparency = info.Transparency or 0,
		Callback = info.Callback, Title = info.Title,
	})
	local H, S, V = CP.Value:ToHSV()
	local hasAlpha = info.Transparency ~= nil

	local Swatch = Btn({
		Size = UDim2.fromOffset(28, 16), BackgroundTransparency = 0, BackgroundColor3 = CP.Value,
		LayoutOrder = NextOrder(), Parent = Addons,
	})
	Corner(Swatch, 4)
	Stroke(Swatch, "OutlineColor")

	local panelH = hasAlpha and 172 or 150
	local Panel = New("Frame", {
		Size = UDim2.new(1, 0, 0, panelH), BackgroundColor3 = "ComponentColor", BackgroundTransparency = 0.15,
		Visible = false, LayoutOrder = NextOrder(), Parent = Holder,
	})
	Corner(Panel, 6)
	Stroke(Panel, "OutlineColor")
	Pad(Panel, 8, 8, 8, 8)

	local SV = New("Frame", { Size = UDim2.new(1, -24, 0, 104), BackgroundColor3 = Color3.fromHSV(H, 1, 1), Parent = Panel })
	Corner(SV, 4)
	local W = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = SV })
	Corner(W, 4)
	New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = W })
	local B = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Parent = SV })
	Corner(B, 4)
	New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = B })
	local SVCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(8, 8), BackgroundTransparency = 1, ZIndex = 3, Parent = SV })
	Round(SVCursor)
	Stroke(SVCursor, "White", 2)

	local Hue = New("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 14, 0, 104),
		BackgroundColor3 = WHITE, Parent = Panel,
	})
	Corner(Hue, 4)
	do
		local kp = {}
		for i = 0, 6 do kp[#kp + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 % 1, 1, 1)) end
		New("UIGradient", { Rotation = 90, Color = ColorSequence.new(kp), Parent = Hue })
	end
	local HueCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 3), BackgroundColor3 = WHITE, ZIndex = 3, Parent = Hue })
	Corner(HueCursor, 2)

	local Alpha, AlphaCursor
	if hasAlpha then
		Alpha = New("Frame", { Position = UDim2.fromOffset(0, 112), Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = CP.Value, Parent = Panel })
		Corner(Alpha, 4)
		New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = Alpha })
		AlphaCursor = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 3, 1, 4), BackgroundColor3 = WHITE, ZIndex = 3, Parent = Alpha })
		Corner(AlphaCursor, 2)
	end

	local Hex = New("TextBox", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = "MainColor", BackgroundTransparency = 0.2, Text = "", FontFace = FONT_MED, TextSize = 12,
		TextColor3 = "FontColor", ClearTextOnFocus = false, Parent = Panel,
	})
	Corner(Hex, 4)
	Stroke(Hex, "OutlineColor")

	local function Render()
		CP.Value = Color3.fromHSV(H, S, V)
		Swatch.BackgroundColor3 = CP.Value
		Swatch.BackgroundTransparency = CP.Transparency
		SV.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
		SVCursor.Position = UDim2.fromScale(S, 1 - V)
		HueCursor.Position = UDim2.new(0.5, 0, H, 0)
		if Alpha then
			Alpha.BackgroundColor3 = CP.Value
			AlphaCursor.Position = UDim2.new(CP.Transparency, 0, 0.5, 0)
		end
		Hex.Text = "#" .. CP.Value:ToHex():upper()
	end

	function CP:SetValueRGB(color, transparency)
		H, S, V = color:ToHSV()
		if transparency then self.Transparency = transparency end
		Render()
		self:_fire()
	end

	function CP:SetValue(hsv, transparency)
		if typeof(hsv) == "Color3" then return self:SetValueRGB(hsv, transparency) end
		H, S, V = hsv[1], hsv[2], hsv[3]
		if transparency then self.Transparency = transparency end
		Render()
		self:_fire()
	end

	function CP:SetVisible(v) Swatch.Visible = v end

	local mode
	local function Drag()
		local m = MousePos()
		if mode == "sv" then
			S = math.clamp((m.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
			V = 1 - math.clamp((m.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
		elseif mode == "hue" then
			H = math.clamp((m.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 0.999)
		elseif mode == "alpha" then
			CP.Transparency = math.clamp((m.X - Alpha.AbsolutePosition.X) / Alpha.AbsoluteSize.X, 0, 1)
		end
		Render()
		CP:_fire()
	end

	local function HitFor(frame, m)
		local hit = Btn({ Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = frame })
		hit.InputBegan:Connect(function(i)
			if IsClick(i) then mode = m Drag() end
		end)
	end
	HitFor(SV, "sv")
	HitFor(Hue, "hue")
	if Alpha then HitFor(Alpha, "alpha") end
	Connect(UIS.InputChanged, function(i) if mode and IsMove(i) then Drag() end end)
	Connect(UIS.InputEnded, function(i) if IsClick(i) then mode = nil end end)

	Hex.FocusLost:Connect(function()
		local ok, c = pcall(Color3.fromHex, Hex.Text)
		if ok and c then CP:SetValueRGB(c) else Render() end
	end)

	Swatch.MouseButton1Click:Connect(function() Panel.Visible = not Panel.Visible end)
	AddTooltip(Swatch, function() return info.Title end)

	Render()
	Options[idx] = CP
	return CP
end

-- keypicker -----------------------------------------------------------------

local SHORT = {
	MouseButton1 = "MB1", MouseButton2 = "MB2", MouseButton3 = "MB3",
	LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl", RightControl = "RCtrl",
	LeftAlt = "LAlt", RightAlt = "RAlt", Return = "Enter", CapsLock = "Caps", Insert = "Ins",
	Backspace = "Bksp", Delete = "Del", PageUp = "PgUp", PageDown = "PgDn",
}
local MOUSE = {
	MB1 = Enum.UserInputType.MouseButton1,
	MB2 = Enum.UserInputType.MouseButton2,
	MB3 = Enum.UserInputType.MouseButton3,
}

local function InputName(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.Keyboard then return input.KeyCode.Name end
	if t == Enum.UserInputType.MouseButton1 then return "MB1" end
	if t == Enum.UserInputType.MouseButton2 then return "MB2" end
	if t == Enum.UserInputType.MouseButton3 then return "MB3" end
	return nil
end

local function Pretty(key)
	return SHORT[key] or key
end

CreateKeyPicker = function(parent, Holder, Addons, idx, info)
	local default = info.Default
	if default == nil or default == "" then default = "None" end
	local KP = Element({
		Type = "KeyPicker", Value = default, Mode = info.Mode or "Toggle", Toggled = false,
		Callback = info.Callback, Text = info.Text or idx, NoUI = info.NoUI,
		SyncToggleState = info.SyncToggleState, Modifiers = {},
	})
	KP._clicks = {}

	local binding = false
	local Button = Btn({
		Size = UDim2.fromOffset(0, 18), AutomaticSize = AUTO_X, BackgroundTransparency = 0.2,
		BackgroundColor3 = "ComponentColor", TextSize = 11, TextColor3 = function()
			return binding and Scheme.AccentColor or Scheme.SubFontColor
		end, Text = Pretty(KP.Value), LayoutOrder = NextOrder(), Parent = Addons,
	})
	Corner(Button, 4)
	Pad(Button, 6, 6, 0, 0)
	local bStroke = Stroke(Button, "OutlineColor")

	-- mode picker (right click)
	local ModePanel = New("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Visible = false, LayoutOrder = NextOrder(), Parent = Holder })
	List(ModePanel, 4, Enum.FillDirection.Horizontal)
	local modeButtons = {}
	local function RefreshModes()
		for m, b in pairs(modeButtons) do
			b.TextColor3 = KP.Mode == m and Scheme.AccentColor or Scheme.SubFontColor
		end
	end
	for i, m in ipairs({ "Always", "Toggle", "Hold", "Press" }) do
		local b = Btn({
			Size = UDim2.new(0.25, -3, 1, 0), BackgroundTransparency = 0.2, BackgroundColor3 = "ComponentColor",
			Text = m, TextSize = 11, LayoutOrder = i, Parent = ModePanel,
			TextColor3 = function() return KP.Mode == m and Scheme.AccentColor or Scheme.SubFontColor end,
		})
		Corner(b, 4)
		modeButtons[m] = b
		b.MouseButton1Click:Connect(function()
			KP.Mode = m
			RefreshModes()
			ModePanel.Visible = false
		end)
	end

	function KP:GetState()
		if self.Mode == "Always" then return true end
		if self.Mode == "Toggle" then return self.Toggled end
		if self.Mode == "Hold" and self.Value ~= "None" then
			if MOUSE[self.Value] then return UIS:IsMouseButtonPressed(MOUSE[self.Value]) end
			local ok, kc = pcall(function() return Enum.KeyCode[self.Value] end)
			return ok and kc ~= nil and UIS:IsKeyDown(kc)
		end
		return false
	end

	function KP:SetValue(data)
		local key, mode = data, nil
		if type(data) == "table" then key, mode = data[1], data[2] end
		if key == nil or key == "" then key = "None" end
		self.Value = key
		if mode then self.Mode = mode RefreshModes() end
		Button.Text = Pretty(key)
		if info.ChangedCallback then task.spawn(info.ChangedCallback, key) end
		self:_fire()
	end

	function KP:OnClick(fn) table.insert(self._clicks, fn) end
	function KP:Update() Button.Text = Pretty(self.Value) end

	Button.MouseButton1Click:Connect(function()
		binding = true
		Button.Text = "..."
		Button.TextColor3 = Scheme.AccentColor
		bStroke.Color = Scheme.AccentColor
	end)
	Button.MouseButton2Click:Connect(function()
		ModePanel.Visible = not ModePanel.Visible
		RefreshModes()
	end)
	AddTooltip(Button, function() return "Click: rebind  ·  Right-click: mode  ·  Esc: clear" end)

	if KP.SyncToggleState and parent and parent.Type == "Toggle" then
		KP.Toggled = parent.Value
		parent:OnChanged(function(v) KP.Toggled = v end)
	end

	local busy = false
	Connect(UIS.InputBegan, function(input)
		if binding then
			local name = InputName(input)
			if not name then return end
			if name == "Escape" or name == "Backspace" then name = "None" end
			binding = false
			Button.TextColor3 = Scheme.SubFontColor
			bStroke.Color = Scheme.OutlineColor
			KP:SetValue(name)
			return
		end
		if KP.Value == "None" or UIS:GetFocusedTextBox() then return end
		if InputName(input) ~= KP.Value then return end

		if KP.Mode == "Toggle" then
			KP.Toggled = not KP.Toggled
			if KP.SyncToggleState and parent and parent.Type == "Toggle" then parent:SetValue(KP.Toggled) end
			if KP.Callback then task.spawn(KP.Callback, KP.Toggled) end
			for _, fn in ipairs(KP._clicks) do task.spawn(fn) end
		elseif KP.Mode == "Press" then
			if info.WaitForCallback then
				if busy then return end
				busy = true
				task.spawn(function()
					if KP.Callback then pcall(KP.Callback, true) end
					busy = false
				end)
			elseif KP.Callback then
				task.spawn(KP.Callback, true)
			end
			for _, fn in ipairs(KP._clicks) do task.spawn(fn) end
		elseif KP.Mode == "Hold" then
			if KP.Callback then task.spawn(KP.Callback, true) end
		end
	end)
	Connect(UIS.InputEnded, function(input)
		if KP.Mode == "Hold" and KP.Value ~= "None" and InputName(input) == KP.Value and KP.Callback then
			task.spawn(KP.Callback, false)
		end
	end)

	if not KP.NoUI then
		local Entry = Text({ Size = UDim2.new(1, 0, 0, 16), TextSize = 12, TextColor3 = "SubFontColor", LayoutOrder = NextOrder(), Parent = KeybindFrame })
		Connect(RunService.Heartbeat, function()
			Entry.Text = string.format("[%s]  %s  ·  %s", Pretty(KP.Value), KP.Text, KP.Mode)
			Entry.TextColor3 = KP:GetState() and Scheme.AccentColor or Scheme.SubFontColor
		end)
	end

	Options[idx] = KP
	return KP
end

