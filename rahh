function Library:Toggle(state)
	local Main, Scale = self._main, self._scale
	if not Main then return end
	if state == nil then state = not self.Toggled end
	self.Toggled = state
	Tooltip.Visible = false
	if state then
		Main.Visible = true
		Scale.Scale = self.DPIScale * 0.92
		Tween(Scale, { Scale = self.DPIScale }, 0.3, Enum.EasingStyle.Back)
	else
		Tween(Scale, { Scale = self.DPIScale * 0.92 }, 0.12)
		task.delay(0.12, function()
			if not Library.Toggled then Main.Visible = false end
		end)
	end
end

function Library:SetDPIScale(pct)
	self.DPIScale = (tonumber(pct) or 100) / 100
	if self._scale and self.Toggled then Tween(self._scale, { Scale = self.DPIScale }, 0.2) end
end

function Library:SetNotifySide(side)
	self.NotifySide = side
