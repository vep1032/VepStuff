--------------------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------------------

local function NextOrder()
	Library._order += 1
	return Library._order
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library._conns, c)
	return c
end

local function Register(inst, prop, key)
	table.insert(Library.Registry, { inst, prop, key })
end

-- string colour values that name a Scheme key get registered for theme updates,
-- "Flash" = accent that flashes white like the logo, functions = computed colours
local function New(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			local isColor = type(k) == "string" and k:find("Color") ~= nil and class ~= "UIGradient"
			if isColor and v == "Flash" then
				table.insert(Library.Flashing, { inst, k })
				inst[k] = Scheme.AccentColor
			elseif isColor and type(v) == "string" and Scheme[v] ~= nil then
				Register(inst, k, v)
				inst[k] = Scheme[v]
			elseif isColor and type(v) == "function" then
				Register(inst, k, v)
				inst[k] = v()
			else
				inst[k] = v
			end
		end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end

local function Tween(obj, props, time, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Corner(parent, r)
	return New("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = parent })
end

local function Round(parent)
	return New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

local function Stroke(parent, color, thickness, transparency)
	return New("UIStroke", {
		Color = color or "OutlineColor",
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function Pad(parent, l, r, t, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or l or 0),
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or t or 0),
		Parent = parent,
	})
end

local function List(parent, padding, direction, hAlign, vAlign)
	return New("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = direction or Enum.FillDirection.Vertical,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

local function Text(props)
	props.BackgroundTransparency = 1
	props.FontFace = props.FontFace or FONT_MED
	props.TextColor3 = props.TextColor3 or "FontColor"
	props.TextSize = props.TextSize or 13
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.Text = props.Text or ""
	return New("TextLabel", props)
end

local function Btn(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Text = props.Text or ""
	props.AutoButtonColor = false
	props.FontFace = props.FontFace or FONT_MED
	props.TextColor3 = props.TextColor3 or "FontColor"
	props.TextSize = props.TextSize or 13
	return New("TextButton", props)
end

local function IsClick(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function MousePos()
	return UIS:GetMouseLocation()
end

local function MakeDraggable(handle, target)
	local dragging, startInput, startPos = false, nil, nil
	Connect(handle.InputBegan, function(input)
		if IsClick(input) then
			dragging, startInput, startPos = true, input.Position, target.Position
		end
	end)
	Connect(UIS.InputChanged, function(input)
		if dragging and IsMove(input) then
			local d = input.Position - startInput
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	Connect(UIS.InputEnded, function(input)
		if IsClick(input) then dragging = false end
	end)
end

local function Ripple(obj)
	local m = MousePos()
	obj.ClipsDescendants = true
	local c = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(m.X - obj.AbsolutePosition.X, m.Y - obj.AbsolutePosition.Y),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Scheme.AccentColor,
		BackgroundTransparency = 0.55,
		ZIndex = obj.ZIndex + 1,
		Parent = obj,
	})
	Round(c)
	local s = math.max(obj.AbsoluteSize.X, obj.AbsoluteSize.Y) * 2
	Tween(c, { Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1 }, 0.55)
	task.delay(0.6, function() c:Destroy() end)
end

local function Element(obj)
	obj._changed = {}
	function obj:OnChanged(fn)
		table.insert(self._changed, fn)
	end
	function obj:_fire()
		for _, fn in ipairs(self._changed) do task.spawn(fn, self.Value) end
		if self.Callback then task.spawn(self.Callback, self.Value) end
	end
	return obj
end

function Library:UpdateColors()
	for _, e in ipairs(self.Registry) do
		local v
		if type(e[3]) == "function" then
			local ok, r = pcall(e[3])
			v = ok and r or nil
		else
			v = Scheme[e[3]]
		end
		if v ~= nil then
			local inst, prop = e[1], e[2]
			pcall(function() inst[prop] = v end)
		end
	end
end

function Library:SetAccent(color)
	Library.BaseAccent = color
	if not Library.Rainbow then
		Scheme.AccentColor = color
		Library:UpdateColors()
	end
end

function Library:OnUnload(fn)
	table.insert(self._unload, fn)
end

