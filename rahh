--------------------------------------------------------------------------------
-- glass blur (from the original Draco UI) -> returns cleanup
--------------------------------------------------------------------------------

local function MakeGlass(Object)
	local root = Instance.new("Folder")
	root.Name = "DracoGlass"
	root.Parent = Camera

	local DOF = Instance.new("DepthOfFieldEffect")
	DOF.FarIntensity = 0
	DOF.FocusDistance = 51.6
	DOF.InFocusRadius = 50
	DOF.NearIntensity = Library.BlurIntensity
	DOF.Name = "DracoBlur"
	DOF.Parent = Lighting

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 1
	frame.Parent = Object

	while Camera:ScreenPointToRay(0, 0).Origin.X ~= Camera:ScreenPointToRay(0, 0).Origin.X do
		RunService.RenderStepped:Wait()
	end

	local acos, max, pi, sqrt = math.acos, math.max, math.pi, math.sqrt
	local sz = 0.2

	local function DrawTriangle(v1, v2, v3, p0, p1)
		local s1, s2, s3 = (v1 - v2).Magnitude, (v2 - v3).Magnitude, (v3 - v1).Magnitude
		local smax = max(s1, s2, s3)
		local A, B, C
		if s1 == smax then A, B, C = v1, v2, v3
		elseif s2 == smax then A, B, C = v2, v3, v1
		else A, B, C = v3, v1, v2 end

		local para = ((B - A).X * (C - A).X + (B - A).Y * (C - A).Y + (B - A).Z * (C - A).Z) / (A - B).Magnitude
		local perp = sqrt(math.max((C - A).Magnitude ^ 2 - para * para, 0))
		local dif_para = (A - B).Magnitude - para

		local st = CFrame.new(B, A)
		local za = CFrame.Angles(pi / 2, 0, 0)
		local cf0 = st
		local Top_Look = (cf0 * za).LookVector
		local Mid_Point = A + CFrame.new(A, B).LookVector * para
		local Needed_Look = CFrame.new(Mid_Point, C).LookVector
		local dot = math.clamp(Top_Look:Dot(Needed_Look), -1, 1)
		local ac = CFrame.Angles(0, 0, acos(dot))

		cf0 = cf0 * ac
		if ((cf0 * za).LookVector - Needed_Look).Magnitude > 0.01 then
			cf0 = cf0 * CFrame.Angles(0, 0, -2 * acos(dot))
		end
		cf0 = cf0 * CFrame.new(0, perp / 2, -(dif_para + para / 2))

		local cf1 = st * ac * CFrame.Angles(0, pi, 0)
		if ((cf1 * za).LookVector - Needed_Look).Magnitude > 0.01 then
			cf1 = cf1 * CFrame.Angles(0, 0, 2 * acos(dot))
		end
		cf1 = cf1 * CFrame.new(0, perp / 2, dif_para / 2)

		if not p0 then
			p0 = Instance.new("Part")
			p0.TopSurface, p0.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			p0.Anchored, p0.CanCollide, p0.CanQuery, p0.CanTouch, p0.CastShadow = true, false, false, false, false
			p0.Material = Enum.Material.Glass
			p0.Size = Vector3.new(sz, sz, sz)
			p0.BrickColor = BrickColor.new("Institutional white")
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Wedge
			mesh.Name = "WedgeMesh"
			mesh.Parent = p0
		end
		p0.WedgeMesh.Scale = Vector3.new(0, perp / sz, para / sz)
		p0.CFrame = cf0

		if not p1 then p1 = p0:Clone() end
		p1.WedgeMesh.Scale = Vector3.new(0, perp / sz, dif_para / sz)
		p1.CFrame = cf1
		return p0, p1
	end

	local parts = {}
	local function Update()
		local gui = Object:FindFirstAncestorWhichIsA("ScreenGui")
		local visible = Library.BlurEnabled and Object.Parent ~= nil and Object.Visible and gui ~= nil and gui.Enabled
		DOF.Enabled = visible
		DOF.NearIntensity = Library.BlurIntensity
		if not visible then
			for _, p in pairs(parts) do p.Transparency = 1 end
			return
		end
		local cam = workspace.CurrentCamera
		local z = 1 - 0.05 * frame.ZIndex
		local tl, br = frame.AbsolutePosition, frame.AbsolutePosition + frame.AbsoluteSize
		local tr, bl = Vector2.new(br.X, tl.Y), Vector2.new(tl.X, br.Y)
		local v1 = cam:ScreenPointToRay(tl.X, tl.Y, z).Origin
		local v2 = cam:ScreenPointToRay(tr.X, tr.Y, z).Origin
		local v3 = cam:ScreenPointToRay(bl.X, bl.Y, z).Origin
		local v4 = cam:ScreenPointToRay(br.X, br.Y, z).Origin
		parts[1], parts[2] = DrawTriangle(v1, v2, v3, parts[1], parts[2])
		parts[3], parts[4] = DrawTriangle(v3, v2, v4, parts[3], parts[4])
		for _, p in pairs(parts) do
			if p.Parent ~= root then p.Parent = root end
			p.Transparency = 0.98
		end
	end

	local uid = "DracoGlass_" .. HttpService:GenerateGUID(false)
	RunService:BindToRenderStep(uid, 2000, function()
		pcall(Update)
	end)

	return function()
		pcall(function() RunService:UnbindFromRenderStep(uid) end)
		pcall(function() root:Destroy() end)
		pcall(function() DOF:Destroy() end)
		pcall(function() frame:Destroy() end)
	end
end

